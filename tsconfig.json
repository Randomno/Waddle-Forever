{
  "compilerOptions": {
    "skipLibCheck": true,
    "target": "ES2021",
    "module": "commonjs",
    "esModuleInterop": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "compiled",
    "paths": {
      "*": [
        "./node_modules/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "src/client/static/**/*",
    "/dist/**/*",
    "/compiled/**/*"
  ]
}